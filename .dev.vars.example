# ponytail: MLK — Local development secrets for Cloudflare Workers.
# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored — NEVER commit real secrets.
#
# For production: use `npx wrangler secret put <NAME>`

# Rotated hash salt (NOT the exposed 9fad3e8f... — that salt is dead)
# Generate with: openssl rand -hex 32
PIP_VOTER_HASH_SALT=your_rotated_salt_here

# JWT secret for auth (if enabled)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# CSRF secret
# Generate with: openssl rand -hex 32
CSRF_SECRET=your_csrf_secret_here

# App origin for CORS
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Cloudflare Workers AI (optional — alternative LLM backend for the AI Assistant)
# Token from: Cloudflare Dashboard > My Profile > API Tokens > 'plain-breeze-2fe3' > Roll
# Account ID: 20b9d9b232ee8f29aa3e626530f0da09
# Token expires: 2026-07-30
# Models: Llama 3.1 8B/70B, Mistral 7B, Qwen 1.5 14B
CF_ACCOUNT_ID=20b9d9b232ee8f29aa3e626530f0da09
CF_AI_TOKEN=your_cf_api_token_here

# ElectionData.MY REST API (optional — for live candidate history queries)
# Token expires: 30 days from issue
ELECTIONDATA_API_TOKEN=your_edmy_api_token_here

# --- S2D Engine Credentials (Phase 4 — Gear Settings or Wrangler secrets) ---
# Operators configure via Gear Settings Modal (PUT /api/s2d/credentials) or via env/Wrangler secrets.
# Raw tokens are NEVER returned to browser (only masked metadata like apif***9x2a).
# For production: npx wrangler secret put APIFY_TOKEN (and the rest below)
# Official Apify env name (console.apify.com → Settings → API & Integrations).
# Token format: apify_api_…  Auth: Authorization: Bearer <token>
APIFY_TOKEN=apify_api_xxx
# Legacy alias accepted if APIFY_TOKEN is unset
# APIFY_API_TOKEN=
S2D_ALERT_WHATSAPP_TOKEN=your_whatsapp_token_here
S2D_ALERT_EMAIL_TOKEN=your_email_token_here
S2D_BURP_DAST_API_KEY=your_burp_api_key_here
S2D_BURP_DAST_GRAPHQL_URL=https://burp.example.com/graphql
S2D_NETWORK_EVIDENCE_PRIVACY_KEY=your_privacy_key_here
S2D_APIFY_WEBHOOK_SHARED_SECRET=your_32plus_char_shared_secret_here
TIKTOK_API_KEY=your_tiktok_api_key_here

# S2D Engine URL (server-side local dev only). Browser requests always remain
# same-origin and use /api/s2d/intelligence on Workers.
S2D_ENGINE_URL=http://localhost:4000

# Privileged API auth. Generate with: openssl rand -hex 32
# Production callers send Authorization: Bearer <S2D_AUTH_TOKEN>.
S2D_AUTH_TOKEN=your_32plus_char_s2d_operator_token_here

# Optional approved Apify actor/source configuration. Threads has no default
# actor; Facebook collection is disabled until curated Melaka page URLs exist.
S2D_APIFY_ACTOR_THREADS=
S2D_APIFY_ACTOR_X=apidojo~tweet-scraper
S2D_FACEBOOK_SOURCE_URLS=
S2D_APIFY_RESIDENTIAL_PROXY_ENABLED=false

# S2D Security toggles (Cloudflare Workers: active scans not supported in V8 isolates)
S2D_ACTIVE_SECURITY_SCAN_ENABLED=false
S2D_ALLOWED_ORIGINS=https://pip-melaka.ritz-analytics.workers.dev
